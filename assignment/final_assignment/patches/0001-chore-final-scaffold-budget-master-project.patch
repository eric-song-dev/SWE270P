From ab5a0eefe6b16f37c994a7f0352652fd480d2015 Mon Sep 17 00:00:00 2001
From: eric-song-dev <eric.song.life@gmail.com>
Date: Wed, 18 Nov 2026 18:51:22 -0800
Subject: [PATCH 1/9] chore(final): scaffold budget-master project

Dependencies, .env template for the OpenAI-compatible LLM settings, and ignore rules for secrets, the virtualenv and generated projects.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 .env.example     | 13 +++++++++++++
 .gitignore       | 13 +++++++++++++
 requirements.txt |  7 +++++++
 3 files changed, 33 insertions(+)
 create mode 100644 assignment/final_assignment/budget-master/.env.example
 create mode 100644 assignment/final_assignment/budget-master/.gitignore
 create mode 100644 assignment/final_assignment/budget-master/requirements.txt

diff --git a/.env.example b/.env.example
new file mode 100644
index 0000000..0048731
--- /dev/null
+++ b/.env.example
@@ -0,0 +1,13 @@
+# Copy this file to .env and fill in your API key. Any OpenAI-compatible API works.
+LLM_API_KEY=your-api-key-here
+LLM_BASE_URL=https://api.deepseek.com
+LLM_MODEL=deepseek-flash
+
+# DeepSeek only: "disabled" turns thinking mode off (faster, far fewer tokens),
+# "enabled" turns it on. Remove this line for providers without this switch.
+LLM_THINKING=disabled
+
+# Optional tuning (the values below are the defaults)
+# LLM_MAX_TOKENS=16384   # output-token limit of one LLM call
+# AGENT_MAX_STEPS=10     # LLM calls one agent may make per task
+# MAX_FIX_ROUNDS=2       # Coder <-> Tester repair rounds after failing tests
diff --git a/.gitignore b/.gitignore
new file mode 100644
index 0000000..8b225b9
--- /dev/null
+++ b/.gitignore
@@ -0,0 +1,13 @@
+# secrets
+.env
+
+# Python
+.venv/
+__pycache__/
+.pytest_cache/
+
+# projects produced by the AI Coder
+generated/
+
+# macOS
+.DS_Store
diff --git a/requirements.txt b/requirements.txt
new file mode 100644
index 0000000..415f6d2
--- /dev/null
+++ b/requirements.txt
@@ -0,0 +1,7 @@
+# Python 3.10 or newer
+mcp>=2.3,<3           # Model Context Protocol SDK (servers + clients)
+openai>=3.55,<4       # client for any OpenAI-compatible chat-completions API (DeepSeek)
+gradio>=6.32,<7       # web UI
+pytest>=9,<10         # runs the generated test cases
+streamlit>=1.67,<2    # user interface of the generated applications
+python-dotenv>=1.0    # loads the .env file
-- 
2.56.1

