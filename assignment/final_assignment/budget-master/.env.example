# Copy this file to .env and fill in your API key. Any OpenAI-compatible API works.
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# DeepSeek only: "disabled" turns thinking mode off (faster, far fewer tokens),
# "enabled" turns it on. Remove this line for providers without this switch.
LLM_THINKING=disabled

# Optional tuning (the values below are the defaults)
# LLM_MAX_TOKENS=16384   # output-token limit of one LLM call
# AGENT_MAX_STEPS=10     # LLM calls one agent may make per task
# MAX_FIX_ROUNDS=2       # Coder <-> Tester repair rounds after failing tests
